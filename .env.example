# Simulateur iOS / émulateur Android : 127.0.0.1 fonctionne (réseau partagé avec le Mac).
# Téléphone physique (Expo Go) : il FAUT l'IP LAN du Mac — 127.0.0.1 sur le téléphone
# pointe vers le téléphone lui-même, pas vers ton Mac. Trouver l'IP : `ipconfig getifaddr en0`.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.X:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase status -o json → PUBLISHABLE_KEY>
